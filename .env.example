# ============================================================
# FOOTBALL ANALYTICS - CONFIGURAÇÃO DE API KEYS
# ============================================================
# 1. Copie este arquivo para .env:  cp .env.example .env
# 2. Preencha suas chaves de API abaixo
# 3. O arquivo .env NUNCA deve ser commitado no git
# ============================================================

# --- API-Football (RapidAPI) ---
# Obtenha em: https://rapidapi.com/api-sports/api/api-football
RAPIDAPI_KEY=sua_chave_aqui
RAPIDAPI_HOST=api-football-v1.p.rapidapi.com

# --- Football-Data.org (alternativa gratuita) ---
# Obtenha em: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=sua_chave_aqui

# --- Qual API usar como primária? ---
# Opções: "api_football" ou "football_data"
PRIMARY_API=api_football

# --- Configurações de Cache ---
# Tempo de vida do cache em horas para dados de classificação/tabelas
CACHE_STANDINGS_TTL_HOURS=12
# Tempo de vida para calendário de jogos futuros (horas)
CACHE_FIXTURES_TTL_HOURS=6
# Resultados passados nunca expiram (permanente)
CACHE_RESULTS_PERMANENT=true

# --- Configurações do App ---
# Temporada padrão (ano de início)
DEFAULT_SEASON=2026
# Timezone
TIMEZONE=America/Sao_Paulo

# --- Proxy (opcional, para FBref scraping) ---
# HTTP_PROXY=http://seu_proxy:porta
# HTTPS_PROXY=http://seu_proxy:porta
